# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (Go · chi).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 8080; probes: liveness /health, readiness /health.

FROM golang:1.26 AS build
WORKDIR /src
COPY . .
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/server /server
USER nonroot:nonroot
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/server"]
